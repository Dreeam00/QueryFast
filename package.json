    "@typescript-eslint/parser": "^8.59.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "prismjs": "^1.30.0",
    "puppeteer": "^24.43.1",
